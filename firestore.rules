rules_version = '2';
// Firestore rules for the ela-quest project: ELA Quest's rules, unchanged, plus per-app progress for the
// Learning Hub apps under classes/{classId}/students/{studentId}/apps/{appId}.
// Publish: Firebase console → Firestore Database → Rules → paste → Publish. Check: node tools/rules_test.mjs after
service cloud.firestore {
  match /databases/{db}/documents {
    match /classes/{classId} {
      allow get: if request.auth != null;
      allow list, update, delete: if false;
      allow create: if request.auth != null && classId.size() >= 12
        && request.resource.data.keys().hasOnly(['name', 'adminHash', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      match /students/{studentId} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && exists(/databases/$(db)/documents/classes/$(classId))
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'pinHash', 'data', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 30
          && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        // Learning Hub: one document of progress per app per student.
        match /apps/{appId} {
          allow read, delete: if request.auth != null;
          allow create, update: if request.auth != null
            && appId in ['mathquest2', 'mapmath2', 'mapmath4', 'algebra1', 'mapalg1',
                         'mapread2', 'mapread4', 'mapread8', 'satprep', 'hubdemo']
            && exists(/databases/$(db)/documents/classes/$(classId)/students/$(studentId))
            && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
            && request.resource.data.data is string && request.resource.data.data.size() < 400000
            && request.resource.data.updatedAt is int;
        }
      }
    }
  }
}
